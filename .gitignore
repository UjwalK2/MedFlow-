# ==============================================================================
# MedFlow .gitignore
# ==============================================================================

# Python Virtual Environments
.venv/
backend/.venv/
env/
venv/
ENV/
backend/env/
backend/venv/
.Python
env.bak/
venv.bak/

# Python Bytecode and Caches
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js and Frontend Dependencies
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Sensitive Credentials / Local Environment Overrides
# Note: Keep .env.example committed as template
.env
.env.local
.env.*.local

# Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
